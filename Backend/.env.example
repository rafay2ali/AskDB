PORT=5000
# Production defaults to 0.0.0.0; local development defaults to 127.0.0.1.
# HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
